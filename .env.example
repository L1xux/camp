# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# Oracle 컨테이너의 SYS, SYSTEM 비밀번호. 애플리케이션은 이 계정으로 접속하지 않는다.
ORACLE_PASSWORD=

# 애플리케이션 전용 계정. 자기 스키마의 DML, DDL 권한만 가진다.
DB_USER=camp
DB_PASSWORD=

# Sentry 에러 트래킹 DSN. 비워 두면 수집만 꺼지고 기동은 정상이다.
SENTRY_DSN=

# Langfuse LLM 트레이싱. 두 키 중 하나라도 비면 내보내기만 꺼지고 기동은 정상이다.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 이후 외부 API 키가 여기 추가된다 (이슈 #41 YouTube, #43 LLM).
